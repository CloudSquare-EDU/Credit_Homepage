# Database (Neon PostgreSQL Connection String)
# Neon 대시보드에서 복사한 Connection String을 붙여넣기
# 예: postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# JWT (로그인 토큰용 - 32자 이상의 랜덤 문자열)
# 생성 방법: https://generate-secret.vercel.app/32
JWT_SECRET="your-super-secret-jwt-key-change-this-to-random-string"
JWT_EXPIRES_IN="24h"

# Encryption (32자 이상의 문자열 - API 키 암호화용)
# NCP Access Key/Secret Key를 암호화하여 DB에 저장할 때 사용
ENCRYPTION_KEY="your-encryption-key-32-chars-minimum"

# Server
PORT=4000
NODE_ENV=production

# CORS (프론트엔드 URL)
# Vercel 배포 후 주소로 변경 (예: https://your-app.vercel.app)
FRONTEND_URL="https://your-frontend-url.vercel.app"
